rules_version = '2';

// მინდობითი აღზრდის პორტალი — Firestore წესები.
// აპლიკაცია იყენებს ჩაშენებულ (custom) ავტორიზაციას bcrypt-ით, არა Firebase Auth-ს,
// ამიტომ წვდომა ღიაა კლიენტისთვის. თუ მოგვიანებით Firebase Auth ჩაერთვება,
// აქ დაემატება identity-ზე დაფუძნებული შეზღუდვები.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
